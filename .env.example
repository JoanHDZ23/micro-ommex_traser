PORT=4000
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=pluscargo_logging

# ── Seguridad por token de sesión ──
# Secreto para firmar los tokens de sesión (HMAC). DEBE definirse en producción
# con un valor largo y aleatorio (p. ej. `openssl rand -hex 32`). Si se omite,
# se usa un secreto temporal que invalida las sesiones al reiniciar el servidor.
AUTH_TOKEN_SECRET=
# URL del deployment /exec del Apps Script (cuenta de Google que hospeda el WebApp)
GAS_WEBHOOK_URL=https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec
# ID de la carpeta de Drive donde se guardan las tablas/fotos de trazabilidad
DRIVE_PARENT_FOLDER_ID=<ID_CARPETA_DRIVE>
# Limpieza automática por antigüedad (elimina de R2/GitHub y MongoDB).
# El barrido corre por defecto, pero SOLO afecta a las empresas que activaron la
# limpieza desde Configuración (interruptor en la app), respetando sus días.
# Interruptor de emergencia: pon 'false' para desactivar por completo el barrido.
ENABLE_AUTO_CLEANUP=true

# ── Almacenamiento de imágenes en Cloudflare R2 (compatible con S3) ──
# Reemplaza la dependencia de Google Drive para los binarios (fotos).
R2_ACCOUNT_ID=<cloudflare_account_id>
R2_ACCESS_KEY_ID=<r2_access_key_id>
R2_SECRET_ACCESS_KEY=<r2_secret_access_key>
R2_BUCKET=<nombre_del_bucket>
# Base pública del bucket (dominio propio o <bucket>.<hash>.r2.dev). Si se define,
# las URLs son públicas y permanentes; si se omite, se generan URLs firmadas.
R2_PUBLIC_BASE_URL=
# Validez (segundos) de las URLs firmadas cuando no hay base pública. Default 7 días.
R2_SIGNED_URL_TTL=604800

# ── WhatsApp vía Twilio (API oficial) ──
TWILIO_ACCOUNT_SID=<twilio_account_sid>
TWILIO_AUTH_TOKEN=<twilio_auth_token>
# Número remitente de WhatsApp. En sandbox de Twilio: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── WhatsApp Web (Baileys, vía QR) — módulo OPCIONAL y NO oficial ──
# ADVERTENCIA: automatizar WhatsApp Web viola los TOS de WhatsApp; el número
# puede ser baneado. Úsalo bajo tu responsabilidad y con un número secundario.
# La sesión se persiste en MongoDB (colección whatsapp_web_auth).
# Déjalo en 'false' para no exponer estas rutas.
ENABLE_WHATSAPP_WEB=false

# ── GitHub como almacenamiento de imágenes (opcional, para WhatsApp Web) ──
# Repo público donde se suben las imágenes para enviarlas como media.
# AVISO: las imágenes quedan públicas y permanentes en el historial de git.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# ── Correo (SMTP) para enviar los registros completados por email ──
# Si se omiten, el envío por correo se desactiva silenciosamente.
# Ejemplo con Gmail (requiere "Contraseña de aplicación", no la normal):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tucorreo@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx   (contraseña de aplicación de 16 dígitos)
#   SMTP_FROM="Ommex Tracer <tucorreo@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Correo por API HTTP (Resend) — RECOMENDADO en Render (SMTP saliente bloqueado) ──
# Crea la API key en https://resend.com → API Keys. Si RESEND_API_KEY está presente,
# se usa Resend en lugar de SMTP.
#   RESEND_API_KEY=re_xxxxxxxx
#   RESEND_FROM="Klock <onboarding@resend.dev>"
# NOTA: con el remitente onboarding@resend.dev (sin dominio verificado) Resend
# solo entrega al correo dueño de la cuenta. Para enviar a cualquier destinatario,
# verifica un dominio en Resend y usa un from de ese dominio (ej. no-reply@tudominio.com).
RESEND_API_KEY=
RESEND_FROM=